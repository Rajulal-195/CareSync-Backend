NODE_ENV=development
PORT=5000
MONGODB_URI=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
SEED_ADMIN_EMAIL=Admin@caresync.com
SEED_ADMIN_PASSWORD=Admin@caresync.com

# ---------------------------------------------------------------------------
# Notes (this file is a template: copy it to `.env`, never commit `.env`).
#  - MONGODB_URI: a replica set is needed for transactional "new patient + booking"
#    (MongoDB Atlas, or local mongod --replSet rs0), e.g.
#    mongodb://localhost:27017/emr?replicaSet=rs0
#  - JWT_* secrets: at least 32 random chars and different from each other. Generate with:
#    node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#  - Durations use s|m|h|d. The server refuses to start if a required value is missing or invalid.
#  - SEED_ADMIN_PASSWORD: at least 12 characters, with a letter and a digit.
#
# Optional tuning (defaults shown):
# CORS_ORIGINS=                 # extra allowed origins, comma separated (FRONTEND_URL is always allowed)
# COOKIE_SAMESITE=strict        # strict | lax | none  (none requires HTTPS)
# BCRYPT_ROUNDS=12
# API_RATE_LIMIT_MAX=300        # per IP per minute
# LOGIN_RATE_LIMIT_MAX=10       # per IP per 15 minutes
# REFRESH_RATE_LIMIT_MAX=30     # per IP per 15 minutes
# TRUST_PROXY=0                 # number of reverse proxies in front of the API
# APP_TIMEZONE=UTC              # "today" for dashboards and seed data
# LOG_LEVEL=info
# DB_CONNECT_RETRIES=5
# SHUTDOWN_TIMEOUT_MS=10000
# SEED_ADMIN_NAME=Super Admin
# SEED_STAFF_PASSWORD=          # password for seeded doctors/receptionists (random if empty; required in production)
# SEED_SAMPLE_DATA=true         # false = admin only. Defaults to true outside production
